<?xml version='1.0' encoding='UTF-8'?>
<workbook xmlns:user="http://www.tableausoftware.com/xml/user" version="2025.1">
  <datasources>
    <datasource name="net_tension" formatted-name="net_tension" inline="true" version="2025.1">
      <connection class="excel-direct" dbname="C:/Users/JUAN/Desktop/Proyectos/NetTension/data/csv/net_tension.xlsx"/>
      <relation type="table" name="fact_observed_agg" table="[fact_observed_agg$]" connection="excel-direct"/>
      <relation type="table" name="dim_time" table="[dim_time$]" connection="excel-direct"/>
      <relation type="table" name="dim_operator" table="[dim_operator$]" connection="excel-direct"/>
      <relation type="table" name="dim_service" table="[dim_service$]" connection="excel-direct"/>
      <relation type="table" name="dim_geography" table="[dim_geography$]" connection="excel-direct"/>
      <relation type="table" name="fact_eurostat_es" table="[fact_eurostat_es$]" connection="excel-direct"/>
      <relation type="table" name="kpi_hhi" table="[kpi_hhi$]" connection="excel-direct"/>
      <relation type="table" name="dim_eu_context" table="[dim_eu_context$]" connection="excel-direct"/>
      <columns>
        <column name="[Total Revenue]" caption="Total Revenue" datatype="float" role="measure" type="quantitative" hidden="false">
          <calculation class="tableau">SUM([ingresos])</calculation>
        </column>
        <column name="[Total Data Traffic]" caption="Total Data Traffic" datatype="float" role="measure" type="quantitative">
          <calculation class="tableau">SUM([trafico_de_datos])</calculation>
        </column>
        <column name="[Total Lines]" caption="Total Lines" datatype="float" role="measure" type="quantitative">
          <calculation class="tableau">SUM([lineas_o_accesos])</calculation>
        </column>
        <column name="[NSI]" caption="Network Stress Index" datatype="float" role="measure" type="quantitative">
          <calculation class="tableau">SUM([trafico_de_datos]) / SUM([lineas_o_accesos])</calculation>
        </column>
        <column name="[Revenue per Traffic Unit]" caption="Revenue per Traffic Unit" datatype="float" role="measure" type="quantitative">
          <calculation class="tableau">SUM([ingresos]) / SUM([trafico_de_datos])</calculation>
        </column>
        <column name="[HHI]" caption="HHI" datatype="float" role="measure" type="quantitative">
          <calculation class="tableau">AVG([hhi])</calculation>
        </column>
        <column name="[CAGR Gap]" caption="CAGR Gap" datatype="float" role="measure" type="quantitative">
          <calculation class="tableau">(ZN(SUM(IF YEAR([trimestre_dt]) = 2025 THEN [trafico_de_datos] END)) / ZN(SUM(IF YEAR([trimestre_dt]) = 2005 THEN [trafico_de_datos] END))) ^ (1/20) - 1 - (ZN(SUM(IF YEAR([trimestre_dt]) = 2025 THEN [ingresos] END)) / ZN(SUM(IF YEAR([trimestre_dt]) = 2005 THEN [ingresos] END))) ^ (1/20) - 1</calculation>
        </column>
        <column name="[Traffic Index]" caption="Traffic Index (2005=100)" datatype="float" role="measure" type="quantitative">
          <calculation class="tableau">SUM([trafico_de_datos]) / MIN({FIXED : SUM([trafico_de_datos])}) * 100</calculation>
        </column>
        <column name="[Revenue Index]" caption="Revenue Index (2005=100)" datatype="float" role="measure" type="quantitative">
          <calculation class="tableau">SUM([ingresos]) / MIN({FIXED : SUM([ingresos])}) * 100</calculation>
        </column>
        <column name="[Revenue per Line]" caption="Revenue per Line" datatype="float" role="measure" type="quantitative">
          <calculation class="tableau">SUM([ingresos]) / SUM([lineas_o_accesos])</calculation>
        </column>
        <column name="[Macro Contribution Ratio]" caption="Macro Contribution Ratio" datatype="float" role="measure" type="quantitative">
          <calculation class="tableau">SUM([ingresos]) / SUM([gdp_meur])</calculation>
        </column>
        <column name="[OTT Contribution]" caption="OTT Contribution %" datatype="integer" role="measure" type="quantitative">
          <attributes name="current-value">0</attributes>
          <attributes name="min-value">0</attributes>
          <attributes name="max-value">50</attributes>
          <attributes name="step-size">1</attributes>
        </column>
        <column name="[Fair Share CAPEX Relief]" caption="Fair Share CAPEX Relief" datatype="float" role="measure" type="quantitative">
          <calculation class="tableau">17.4 * ([OTT Contribution] / 100)</calculation>
        </column>
        <column name="[Revenue Impact with Fair Share]" caption="Revenue Impact with Fair Share" datatype="float" role="measure" type="quantitative">
          <calculation class="tableau">SUM([ingresos]) + ([Fair Share CAPEX Relief] * 1000)</calculation>
        </column>
        <column name="[Market Concentration Level]" caption="Market Concentration Level" datatype="string" role="dimension" type="nominal">
          <calculation class="tableau">IF AVG([hhi]) &lt; 1000 THEN "Competitive" ELSEIF AVG([hhi]) &lt;= 2500 THEN "Moderately Concentrated" ELSE "Highly Concentrated" END</calculation>
        </column>
      </columns>
    </datasource>
  </datasources>
</workbook>
