          {
            "name": "dim_time",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(\"C:/Users/JUAN/Desktop/Proyectos/NetTension/data/csv/dim_time.csv\"),[Delimiter=\";\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),\n    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\", {{\"time_key\", type datetime}, {\"trimestre_dt\", type datetime}, {\"year\", Int64.Type}, {\"quarter\", Int64.Type}, {\"year_quarter\", type text}})\nin\n    #\"Changed Type\""
            }
          }
